; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
; RUN: llc -mtriple=riscv64 -mattr=+m,+xrevivevec -verify-machineinstrs < %s \
; RUN:   | FileCheck %s --check-prefixes=CHECK,ZMMUL
; RUN: llc -mtriple=riscv64 -mattr=+xrevivevec -verify-machineinstrs < %s \
; RUN:   | FileCheck %s --check-prefixes=CHECK,NOMUL

; Widened operands with a truncated result: the wide instruction would be doing
; XLen work in a 256-bit register, so the scalar one is selected instead.
; Multiply is the exception -- scalar MUL needs Zmmul -- hence the second run.

define i64 @narrow_add(i64 %a, i64 %b) {
; CHECK-LABEL: narrow_add:
; CHECK:       # %bb.0:
; CHECK-NEXT:    add a0, a0, a1
; CHECK-NEXT:    ret
  %x = zext i64 %a to i256
  %y = zext i64 %b to i256
  %r = add i256 %x, %y
  %t = trunc i256 %r to i64
  ret i64 %t
}

