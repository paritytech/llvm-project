define i64 @narrow_mul(i64 %a, i64 %b) {
; ZMMUL-LABEL: narrow_mul:
; ZMMUL:       # %bb.0:
; ZMMUL-NEXT:    mul a0, a0, a1
; ZMMUL-NEXT:    ret
;
; NOMUL-LABEL: narrow_mul:
; NOMUL:       # %bb.0:
; NOMUL-NEXT:    vsetivli zero, 4, e64, m2, ta, ma
; NOMUL-NEXT:    revive.wzext v8, a0
; NOMUL-NEXT:    revive.wzext v10, a1
; NOMUL-NEXT:    revive.wmul v8, v8, v10
; NOMUL-NEXT:    revive.wtrunc a0, v8
; NOMUL-NEXT:    ret
  %x = zext i64 %a to i256
  %y = zext i64 %b to i256
  %r = mul i256 %x, %y
  %t = trunc i256 %r to i64
  ret i64 %t
}

; Zero extension preserves unsigned order, so compares narrow too.
define i64 @narrow_ult(i64 %a, i64 %b) {
; CHECK-LABEL: narrow_ult:
; CHECK:       # %bb.0:
; CHECK-NEXT:    sltu a0, a0, a1
; CHECK-NEXT:    ret
  %x = zext i64 %a to i256
  %y = zext i64 %b to i256
  %c = icmp ult i256 %x, %y
  %r = zext i1 %c to i64
  ret i64 %r
}

define i64 @narrow_ugt(i64 %a, i64 %b) {
