; RUN: llc -mtriple=riscv64 -mattr=+m,+xrevivevec -verify-machineinstrs < %s \
; RUN:   | FileCheck %s

; Full-width access is one instruction. Narrower accesses go through a GPR, and
; i128 is not a legal type so its load and store are lowered by hand as limbs.

define i256 @load_i256(ptr %p) {
; CHECK-LABEL: load_i256:
; CHECK:       # %bb.0:
; CHECK-NEXT:    revive.wld v8, 0(a0)
; CHECK-NEXT:    ret
  %v = load i256, ptr %p
  ret i256 %v
}

define void @store_i256(ptr %p, i256 %v) {
; CHECK-LABEL: store_i256:
; CHECK:       # %bb.0:
; CHECK-NEXT:    revive.wst v8, 0(a0)
; CHECK-NEXT:    ret
  store i256 %v, ptr %p
  ret void
}

define i256 @load_i256_offset(ptr %p) {
; CHECK-LABEL: load_i256_offset:
; CHECK:       # %bb.0:
; CHECK-NEXT:    revive.wld v8, 32(a0)
; CHECK-NEXT:    ret
  %q = getelementptr i256, ptr %p, i64 1
  %v = load i256, ptr %q
  ret i256 %v
}

