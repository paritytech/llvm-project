; CHECK-NEXT:    revive.wsrl v8, v8, a2
; CHECK-NEXT:    revive.wtrunc a2, v8
; CHECK-NEXT:    sd a1, 0(a0)
; CHECK-NEXT:    sd a2, 8(a0)
; CHECK-NEXT:    ret
