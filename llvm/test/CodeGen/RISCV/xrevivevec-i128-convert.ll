; I128-LABEL: trunc_i256_to_i128:
; I128:       # %bb.0:
; I128-NEXT:    revive.wld v8, 0(a0)
; I128-NEXT:    revive.wld v10, 0(a1)
; I128-NEXT:    revive.wadd v8, v8, v10
; I128-NEXT:    revive.wst.i128 v8, 0(a2)
; I128-NEXT:    ret
;
; NOI128-LABEL: trunc_i256_to_i128:
; NOI128:       # %bb.0:
; NOI128-NEXT:    revive.wld v8, 0(a0)
; NOI128-NEXT:    revive.wld v10, 0(a1)
; NOI128-NEXT:    li a0, 64
; NOI128-NEXT:    revive.wadd v8, v8, v10
; NOI128-NEXT:    revive.wtrunc a1, v8
; NOI128-NEXT:    revive.wsrl v8, v8, a0
; NOI128-NEXT:    revive.wtrunc a0, v8
; NOI128-NEXT:    sd a1, 0(a2)
; NOI128-NEXT:    sd a0, 8(a2)
; NOI128-NEXT:    ret
  %a = load i256, ptr %p
  %b = load i256, ptr %q
  %c = add i256 %a, %b
  %t = trunc i256 %c to i128
  store i128 %t, ptr %r
  ret void
}

