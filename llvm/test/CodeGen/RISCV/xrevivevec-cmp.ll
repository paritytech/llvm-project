; CHECK-NEXT:    revive.wsltu a0, w0, w1
; CHECK-NEXT:    beqz a0, .LBB10_2
; CHECK-NEXT:  # %bb.1: # %t
; CHECK-NEXT:    li a0, 1
; CHECK-NEXT:  .LBB10_2: # %f
; CHECK-NEXT:    ret
  %c = icmp ult i256 %a, %b
  br i1 %c, label %t, label %f
t:
