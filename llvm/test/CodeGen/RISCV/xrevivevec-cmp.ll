; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
; RUN: llc -mtriple=riscv64 -mattr=+m,+xrevivevec -verify-machineinstrs < %s \
; RUN:   | FileCheck %s

; Four comparisons have instructions; the reversed forms swap operands and the
; rest invert, so all ten predicates must select without expanding.

define i64 @cmp_eq(i256 %a, i256 %b) {
; CHECK-LABEL: cmp_eq:
; CHECK:       # %bb.0:
; CHECK-NEXT:    revive.wseq a0, w0, w1
; CHECK-NEXT:    ret
  %c = icmp eq i256 %a, %b
  %z = zext i1 %c to i64
  ret i64 %z
}

