; Significant bits at both ends, so no shift of an XLen value reaches it and it
; comes from a pool entry of its own width. The offset of a wide instruction
; cannot carry a relocation, so the address is materialized in full and the load
; takes offset zero.
define void @const_pool(ptr %r) {
; CHECK-LABEL: const_pool:
; CHECK:       # %bb.0:
; CHECK-NEXT:    lui a1, %hi(.LCPI50_0)
; CHECK-NEXT:    addi a1, a1, %lo(.LCPI50_0)
; CHECK-NEXT:    revive.wld.i128 v8, 0(a1)
; CHECK-NEXT:    revive.wst.i128 v8, 0(a0)
; CHECK-NEXT:    ret
  store i128 1512366075204170947332355369683137040, ptr %r
  ret void
}

