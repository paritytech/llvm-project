; There is no wide conditional move, so a select becomes the conditional-branch
; triangle its own pseudo expands to. Both arms are computed, so each sinks into
; a branch of the triangle and the value needs no register copy, which would
; otherwise cost a move of its own at this width.
define void @select_i128(ptr %p, ptr %q, ptr %r, i64 %c) {
; CHECK-LABEL: select_i128:
; CHECK:       # %bb.0:
; CHECK-NEXT:    revive.wld.i128 v8, 0(a0)
; CHECK-NEXT:    revive.wld.i128 v9, 0(a1)
; CHECK-NEXT:    beqz a3, .LBB45_2
; CHECK-NEXT:  # %bb.1:
; CHECK-NEXT:    revive.wsub.i128 v8, v8, v9
; CHECK-NEXT:    revive.wst.i128 v8, 0(a2)
; CHECK-NEXT:    ret
; CHECK-NEXT:  .LBB45_2:
; CHECK-NEXT:    revive.wadd.i128 v8, v8, v9
; CHECK-NEXT:    revive.wst.i128 v8, 0(a2)
; CHECK-NEXT:    ret
  %a = load i128, ptr %p
  %b = load i128, ptr %q
  %x = add i128 %a, %b
  %y = sub i128 %a, %b
  %t = icmp eq i64 %c, 0
  %s = select i1 %t, i128 %x, i128 %y
  store i128 %s, ptr %r
  ret void
}

define void @select_wide_cond(ptr %p, ptr %q, ptr %r) {
; CHECK-LABEL: select_wide_cond:
; CHECK:       # %bb.0:
; CHECK-NEXT:    revive.wld.i128 v8, 0(a0)
; CHECK-NEXT:    revive.wld.i128 v9, 0(a1)
; CHECK-NEXT:    revive.wsltu.i128 a0, v8, v9
; CHECK-NEXT:    bnez a0, .LBB46_2
; CHECK-NEXT:  # %bb.1:
; CHECK-NEXT:    revive.wsub.i128 v8, v8, v9
; CHECK-NEXT:    revive.wst.i128 v8, 0(a2)
; CHECK-NEXT:    ret
; CHECK-NEXT:  .LBB46_2:
; CHECK-NEXT:    revive.wadd.i128 v8, v8, v9
; CHECK-NEXT:    revive.wst.i128 v8, 0(a2)
; CHECK-NEXT:    ret
  %a = load i128, ptr %p
  %b = load i128, ptr %q
  %x = add i128 %a, %b
  %y = sub i128 %a, %b
  %t = icmp ult i128 %a, %b
  %s = select i1 %t, i128 %x, i128 %y
  store i128 %s, ptr %r
  ret void
}

; Sign-extending into the wider type while the narrow value stays live: the
; pair's low half and the value itself end up in the same register, so the
; extension costs nothing beyond the shift; landing them apart would cost a
; move of the low half as well.
define void @sext_i128_still_live(ptr %p, ptr %q, ptr %r) {
; CHECK-LABEL: sext_i128_still_live:
; CHECK:       # %bb.0:
; CHECK-NEXT:    revive.wld.i128 v8, 0(a0)
; CHECK-NEXT:    li a0, 127
; CHECK-NEXT:    revive.wsra.i128 v9, v8, a0
; CHECK-NEXT:    revive.wst v8, 0(a1)
; CHECK-NEXT:    revive.wst.i128 v8, 0(a2)
; CHECK-NEXT:    ret
  %v = load i128, ptr %p
  %s = sext i128 %v to i256
  store i256 %s, ptr %q
  store i128 %v, ptr %r
  ret void
}

; A value that fits an XLen register is built there and widened.
