; Counting bits produces an XLen value, which is what the caller wants here.
; A count that must be defined at zero is despeculated into a compare and a
; branch before the backend sees it, exactly as the wider type is in this
; configuration; the zero-undef forms below are the bare instruction.
define void @cpop_i128(ptr %p, ptr %r) {
; CHECK-LABEL: cpop_i128:
; CHECK:       # %bb.0:
; CHECK-NEXT:    revive.wld.i128 v8, 0(a0)
; CHECK-NEXT:    revive.wcpop.i128 a0, v8
; CHECK-NEXT:    revive.wzext.i128 v8, a0
; CHECK-NEXT:    revive.wtrunc.i128 a0, v8
; CHECK-NEXT:    sd a0, 0(a1)
; CHECK-NEXT:    ret
  %a = load i128, ptr %p
  %c = call i128 @llvm.ctpop.i128(i128 %a)
  %n = trunc i128 %c to i64
  store i64 %n, ptr %r
  ret void
}

