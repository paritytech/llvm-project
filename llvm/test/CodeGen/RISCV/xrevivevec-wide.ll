; RUN:   | FileCheck %s

; i512 and i1024 are machine types too, in VRM4 and VRM8. The instruction set is
; the same at every width; only the opcode space and register class change.

define i512 @add_512(i512 %a, i512 %b) {
; CHECK-LABEL: add_512:
; CHECK:       # %bb.0:
; CHECK-NEXT:    vsetivli zero, 8, e64, m4, ta, ma
; CHECK-NEXT:    revive.wadd v8, v8, v12
; CHECK-NEXT:    ret
  %r = add i512 %a, %b
  ret i512 %r
}

define i1024 @add_1024(i1024 %a, i1024 %b) {
; CHECK-LABEL: add_1024:
; CHECK:       # %bb.0:
; CHECK-NEXT:    vsetivli zero, 16, e64, m8, ta, ma
; CHECK-NEXT:    revive.wadd v8, v8, v16
; CHECK-NEXT:    ret
  %r = add i1024 %a, %b
  ret i1024 %r
}

