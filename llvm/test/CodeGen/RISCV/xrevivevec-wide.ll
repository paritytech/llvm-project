; The select pseudo is per register class, so each width needs its own.
define i512 @select_512(i1 %c, i512 %a, i512 %b) {
; CHECK-LABEL: select_512:
; CHECK:       # %bb.0:
; CHECK-NEXT:    andi a0, a0, 1
; CHECK-NEXT:    bnez a0, .LBB12_2
; CHECK-NEXT:  # %bb.1:
; CHECK-NEXT:    revive.wmv4r v8, v12
; CHECK-NEXT:  .LBB12_2:
; CHECK-NEXT:    ret
  %r = select i1 %c, i512 %a, i512 %b
  ret i512 %r
}

